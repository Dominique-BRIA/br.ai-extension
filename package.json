{
  "name": "br-ia",
  "displayName": "br.ia",
  "description": "%description%",
  "version": "0.5.0",
  "private": true,
  "publisher": "br-ia",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dominique-BRIA/br.ai-extension.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bria",
          "title": "br.ia",
          "icon": "media/bria.svg"
        }
      ]
    },
    "views": {
      "bria": [
        {
          "id": "bria.teams",
          "name": "%view.teams%",
          "icon": "media/bria.svg"
        },
        {
          "id": "bria.memory",
          "name": "%view.memory%"
        },
        {
          "id": "bria.orders",
          "name": "%view.orders%"
        },
        {
          "type": "webview",
          "id": "bria.chat",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "bria.signIn",
        "title": "%command.signIn%",
        "category": "br.ia",
        "icon": "$(account)"
      },
      {
        "command": "bria.signOut",
        "title": "%command.signOut%",
        "category": "br.ia",
        "icon": "$(sign-out)"
      },
      {
        "command": "bria.connect",
        "title": "%command.connect%",
        "category": "br.ia",
        "icon": "$(plug)"
      },
      {
        "command": "bria.disconnect",
        "title": "%command.disconnect%",
        "category": "br.ia",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "bria.showLog",
        "title": "%command.showLog%",
        "category": "br.ia",
        "icon": "$(output)"
      },
      {
        "command": "bria.refresh",
        "title": "%command.refresh%",
        "category": "br.ia",
        "icon": "$(refresh)"
      },
      {
        "command": "bria.createTeam",
        "title": "%command.createTeam%",
        "category": "br.ia",
        "icon": "$(add)"
      },
      {
        "command": "bria.joinTeam",
        "title": "%command.joinTeam%",
        "category": "br.ia",
        "icon": "$(sign-in)"
      },
      {
        "command": "bria.invite",
        "title": "%command.invite%",
        "category": "br.ia",
        "icon": "$(person-add)"
      },
      {
        "command": "bria.leaveTeam",
        "title": "%command.leaveTeam%",
        "category": "br.ia"
      },
      {
        "command": "bria.createProject",
        "title": "%command.createProject%",
        "category": "br.ia",
        "icon": "$(new-file)"
      },
      {
        "command": "bria.openProject",
        "title": "%command.openProject%",
        "category": "br.ia"
      },
      {
        "command": "bria.renameProject",
        "title": "%command.renameProject%",
        "category": "br.ia",
        "icon": "$(edit)"
      },
      {
        "command": "bria.archiveProject",
        "title": "%command.archiveProject%",
        "category": "br.ia",
        "icon": "$(archive)"
      },
      {
        "command": "bria.removeMember",
        "title": "%command.removeMember%",
        "category": "br.ia"
      },
      {
        "command": "bria.transferChef",
        "title": "%command.transferChef%",
        "category": "br.ia"
      },
      {
        "command": "bria.editProfile",
        "title": "%command.editProfile%",
        "category": "br.ia",
        "icon": "$(account)"
      },
      {
        "command": "bria.manageMachines",
        "title": "%command.manageMachines%",
        "category": "br.ia",
        "icon": "$(vm)"
      },
      {
        "command": "bria.deleteAccount",
        "title": "%command.deleteAccount%",
        "category": "br.ia"
      },
      {
        "command": "bria.memory.resolve",
        "title": "%command.memory.resolve%",
        "category": "br.ia",
        "icon": "$(check)"
      },
      {
        "command": "bria.memory.reopen",
        "title": "%command.memory.reopen%",
        "category": "br.ia",
        "icon": "$(discard)"
      },
      {
        "command": "bria.memory.stop",
        "title": "%command.memory.stop%",
        "category": "br.ia",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bria.memory.reveal",
        "title": "%command.memory.reveal%",
        "category": "br.ia",
        "icon": "$(comment)"
      },
      {
        "command": "bria.memory.openDocument",
        "title": "%command.memory.openDocument%",
        "category": "br.ia",
        "icon": "$(open-preview)"
      },
      {
        "command": "bria.memory.refresh",
        "title": "%command.memory.refresh%",
        "category": "br.ia",
        "icon": "$(refresh)"
      },
      {
        "command": "bria.linkFolder",
        "title": "%command.linkFolder%",
        "category": "br.ia",
        "icon": "$(folder)"
      },
      {
        "command": "bria.unlinkFolder",
        "title": "%command.unlinkFolder%",
        "category": "br.ia"
      },
      {
        "command": "bria.setPermissionMode",
        "title": "%command.setPermissionMode%",
        "category": "br.ia",
        "icon": "$(shield)"
      },
      {
        "command": "bria.toggleLending",
        "title": "%command.toggleLending%",
        "category": "br.ia",
        "icon": "$(vm-connect)"
      },
      {
        "command": "bria.order.stop",
        "title": "%command.order.stop%",
        "category": "br.ia",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bria.order.stopCurrent",
        "title": "%command.order.stopCurrent%",
        "category": "br.ia",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bria.order.revert",
        "title": "%command.order.revert%",
        "category": "br.ia",
        "icon": "$(discard)"
      },
      {
        "command": "bria.orders.refresh",
        "title": "%command.orders.refresh%",
        "category": "br.ia",
        "icon": "$(refresh)"
      },
      {
        "command": "bria.proposal.accept",
        "title": "%command.proposal.accept%",
        "category": "br.ia",
        "icon": "$(check)"
      },
      {
        "command": "bria.proposal.reject",
        "title": "%command.proposal.reject%",
        "category": "br.ia",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bria.openProject",
          "when": "false"
        },
        {
          "command": "bria.renameProject",
          "when": "false"
        },
        {
          "command": "bria.archiveProject",
          "when": "false"
        },
        {
          "command": "bria.removeMember",
          "when": "false"
        },
        {
          "command": "bria.transferChef",
          "when": "false"
        },
        {
          "command": "bria.signIn",
          "when": "!bria.signedIn"
        },
        {
          "command": "bria.signOut",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.createTeam",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.joinTeam",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.invite",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.leaveTeam",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.createProject",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.refresh",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.editProfile",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.manageMachines",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.deleteAccount",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.memory.resolve",
          "when": "false"
        },
        {
          "command": "bria.memory.reopen",
          "when": "false"
        },
        {
          "command": "bria.memory.stop",
          "when": "false"
        },
        {
          "command": "bria.memory.reveal",
          "when": "false"
        },
        {
          "command": "bria.memory.openDocument",
          "when": "bria.projectOpen"
        },
        {
          "command": "bria.memory.refresh",
          "when": "bria.projectOpen"
        },
        {
          "command": "bria.linkFolder",
          "when": "false"
        },
        {
          "command": "bria.unlinkFolder",
          "when": "false"
        },
        {
          "command": "bria.order.stop",
          "when": "false"
        },
        {
          "command": "bria.order.revert",
          "when": "false"
        },
        {
          "command": "bria.proposal.accept",
          "when": "false"
        },
        {
          "command": "bria.proposal.reject",
          "when": "false"
        },
        {
          "command": "bria.setPermissionMode",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.toggleLending",
          "when": "bria.signedIn"
        },
        {
          "command": "bria.order.stopCurrent",
          "when": "bria.cooking"
        },
        {
          "command": "bria.orders.refresh",
          "when": "bria.projectOpen"
        }
      ],
      "view/title": [
        {
          "command": "bria.createTeam",
          "when": "view == bria.teams && bria.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "bria.joinTeam",
          "when": "view == bria.teams && bria.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "bria.refresh",
          "when": "view == bria.teams && bria.signedIn",
          "group": "navigation@3"
        },
        {
          "command": "bria.editProfile",
          "when": "view == bria.teams && bria.signedIn",
          "group": "9_account@1"
        },
        {
          "command": "bria.manageMachines",
          "when": "view == bria.teams && bria.signedIn",
          "group": "9_account@2"
        },
        {
          "command": "bria.signOut",
          "when": "view == bria.teams && bria.signedIn",
          "group": "9_account@3"
        },
        {
          "command": "bria.deleteAccount",
          "when": "view == bria.teams && bria.signedIn",
          "group": "9_account@4"
        },
        {
          "command": "bria.connect",
          "when": "view == bria.chat && bria.signedIn && bria.connectionState != connected",
          "group": "navigation"
        },
        {
          "command": "bria.disconnect",
          "when": "view == bria.chat && bria.connectionState == connected",
          "group": "navigation"
        },
        {
          "command": "bria.showLog",
          "when": "view == bria.chat",
          "group": "9_log"
        },
        {
          "command": "bria.memory.openDocument",
          "when": "view == bria.memory && bria.projectOpen",
          "group": "navigation@1"
        },
        {
          "command": "bria.memory.refresh",
          "when": "view == bria.memory && bria.projectOpen",
          "group": "navigation@2"
        },
        {
          "command": "bria.order.stopCurrent",
          "when": "view == bria.orders && bria.cooking",
          "group": "navigation@1"
        },
        {
          "command": "bria.setPermissionMode",
          "when": "view == bria.orders && bria.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "bria.orders.refresh",
          "when": "view == bria.orders && bria.projectOpen",
          "group": "navigation@3"
        },
        {
          "command": "bria.toggleLending",
          "when": "view == bria.orders && bria.signedIn",
          "group": "9_machine@1"
        }
      ],
      "view/item/context": [
        {
          "command": "bria.createProject",
          "when": "view == bria.teams && viewItem =~ /^team./",
          "group": "inline@1"
        },
        {
          "command": "bria.invite",
          "when": "view == bria.teams && viewItem == team.chef",
          "group": "inline@2"
        },
        {
          "command": "bria.createProject",
          "when": "view == bria.teams && viewItem =~ /^team./",
          "group": "1_team@1"
        },
        {
          "command": "bria.invite",
          "when": "view == bria.teams && viewItem == team.chef",
          "group": "1_team@2"
        },
        {
          "command": "bria.leaveTeam",
          "when": "view == bria.teams && viewItem == team.membre",
          "group": "9_leave"
        },
        {
          "command": "bria.renameProject",
          "when": "view == bria.teams && viewItem =~ /^project./",
          "group": "1_project@1"
        },
        {
          "command": "bria.archiveProject",
          "when": "view == bria.teams && viewItem =~ /^project\\.chef/",
          "group": "1_project@2"
        },
        {
          "command": "bria.transferChef",
          "when": "view == bria.teams && viewItem == member.manageable",
          "group": "1_member@1"
        },
        {
          "command": "bria.removeMember",
          "when": "view == bria.teams && viewItem == member.manageable",
          "group": "1_member@2"
        },
        {
          "command": "bria.memory.resolve",
          "when": "view == bria.memory && viewItem =~ /^memory.(question|task|compromise).open/",
          "group": "inline@1"
        },
        {
          "command": "bria.memory.resolve",
          "when": "view == bria.memory && viewItem =~ /^memory.(question|task|compromise).open/",
          "group": "1_memory@1"
        },
        {
          "command": "bria.memory.reopen",
          "when": "view == bria.memory && viewItem =~ /^memory.(question|task|compromise).resolved/",
          "group": "1_memory@2"
        },
        {
          "command": "bria.memory.stop",
          "when": "view == bria.memory && viewItem =~ /^memory.decision.open.chef/",
          "group": "1_memory@3"
        },
        {
          "command": "bria.memory.reveal",
          "when": "view == bria.memory && viewItem =~ /^memory./",
          "group": "2_show@1"
        },
        {
          "command": "bria.linkFolder",
          "when": "view == bria.teams && viewItem =~ /^project\\./",
          "group": "2_folder@1"
        },
        {
          "command": "bria.unlinkFolder",
          "when": "view == bria.teams && viewItem =~ /^project\\..*\\.linked$/",
          "group": "2_folder@2"
        },
        {
          "command": "bria.order.stop",
          "when": "view == bria.orders && viewItem =~ /stoppable/",
          "group": "inline@1"
        },
        {
          "command": "bria.order.stop",
          "when": "view == bria.orders && viewItem =~ /stoppable/",
          "group": "1_order@1"
        },
        {
          "command": "bria.order.revert",
          "when": "view == bria.orders && viewItem =~ /revertable/",
          "group": "1_order@2"
        }
      ],
      "editor/title": [
        {
          "command": "bria.proposal.accept",
          "when": "resourceScheme == bria-proposal",
          "group": "navigation@1"
        },
        {
          "command": "bria.proposal.reject",
          "when": "resourceScheme == bria-proposal",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "br.ia",
      "properties": {
        "bria.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "markdownDescription": "%config.serverUrl%"
        },
        "bria.notifyMentions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifyMentions%"
        },
        "bria.permissionMode": {
          "type": "string",
          "enum": [
            "manual",
            "autoEdit",
            "auto",
            "plan"
          ],
          "enumDescriptions": [
            "%config.permissionMode.manual%",
            "%config.permissionMode.autoEdit%",
            "%config.permissionMode.auto%",
            "%config.permissionMode.plan%"
          ],
          "default": "manual",
          "markdownDescription": "%config.permissionMode%"
        },
        "bria.lendMachine": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.lendMachine%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "bria.teams",
        "contents": "%welcome.signedOut%",
        "when": "!bria.signedIn"
      },
      {
        "view": "bria.teams",
        "contents": "%welcome.noTeams%",
        "when": "bria.signedIn && !bria.hasTeams"
      },
      {
        "view": "bria.memory",
        "contents": "%welcome.memoryNoProject%",
        "when": "bria.signedIn && !bria.projectOpen"
      },
      {
        "view": "bria.memory",
        "contents": "%welcome.memoryEmpty%",
        "when": "bria.signedIn && bria.projectOpen && bria.memoryEmpty"
      },
      {
        "view": "bria.orders",
        "contents": "%welcome.ordersNoProject%",
        "when": "bria.signedIn && !bria.projectOpen"
      },
      {
        "view": "bria.orders",
        "contents": "%welcome.ordersEmpty%",
        "when": "bria.signedIn && bria.projectOpen && bria.ordersEmpty"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@br-ia/protocol": "file:../backend/packages/protocol",
    "@vscode/codicons": "^0.0.46-24",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.95.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
